# FinAudit AI — Backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# Port the API server listens on
PORT=5000

# Node environment: "development" or "production"
NODE_ENV=development

# Frontend origin (used for CORS + credentials). In production, when the backend
# serves the built frontend from the same origin, set this to your public URL
# (e.g. https://your-app.com). In development it defaults to the Vite dev server.
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/finaudit

# Secret used to sign auth tokens. Use a LONG, RANDOM string (at least 32 chars).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Google Gemini API key (https://aistudio.google.com/app/apikey) — required for
# the upload/audit pipeline to work.
GEMINI_API_KEY=replace_with_your_gemini_api_key