# FinAudit AI — Frontend environment variables
# Copy this file to `.env` and adjust if needed. NEVER commit the real `.env`.

# Base URL of the backend API. Leave unset for the default same-origin `/api`
# (works in dev via Vite's proxy and in prod when the backend serves the
# built frontend). Set an absolute URL only for a cross-origin deployment,
# e.g.:
# VITE_API_URL=http://localhost:5000